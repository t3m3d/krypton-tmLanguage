{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Krypton",
  "scopeName": "source.krypton",
  "fileTypes": ["k", "ks"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#entry-point" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.krypton",
          "match": "//.*$"
        },
        {
          "name": "comment.block.krypton",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.krypton",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.krypton",
              "match": "\\\\[nrt\\\\\"']"
            }
          ]
        },
        {
          "name": "string.interpolated.krypton",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.krypton",
              "match": "\\\\[nrt\\\\`']"
            },
            {
              "name": "meta.embedded.expression.krypton",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#builtins" },
                { "include": "#numbers" },
                { "include": "#strings" },
                { "include": "#operators" },
                { "include": "#identifiers" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.krypton",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.krypton",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.krypton",
          "match": "\\b(if|else|while|for|in|do|loop|until|break|continue|match|emit|return|try|catch|throw)\\b"
        },
        {
          "name": "keyword.declaration.krypton",
          "match": "\\b(func|fn|let|const|module|import|export|struct|class|type|callback|jxt)\\b"
        },
        {
          "name": "keyword.other.entry.krypton",
          "match": "\\b(just|go)\\b"
        },
        {
          "name": "keyword.other.quantum.krypton",
          "match": "\\b(quantum|qpute|process|measure|prepare)\\b"
        },
        {
          "name": "constant.language.boolean.krypton",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.krypton",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.krypton",
          "match": "\\b(kp|print|printErr|len|length|count|substring|toInt|toStr|parseInt|split|range|startsWith|endsWith|contains|indexOf|replace|trim|toUpper|toLower|reverse|repeat|padLeft|padRight|pow|abs|min|max|bin|hex|sign|clamp|charCode|fromCharCode|isDigit|isAlpha|isAlphaNum|isTruthy|readFile|writeFile|arg|argCount|getLine|lineCount|exit|tokenize|tokAt|tokVal|tokType|sbNew|sbAppend|sbToString|envNew|envSet|envGet|structNew|setField|getField|hasField|structFields|pairVal|pairPos|pairNew|makeResult|getResultVal|getResultPos|getResultFlag|getResultEnv|getResultTag|join|slice|splitBy|sort|unique|fill|zip|keys|values|hasKey|mapGet|mapSet|remove|sumList|minList|maxList|countOf|listIndexOf|every|some|gcAllocated|gcLimit|gcSetLimit|gcCollect|gcReset|gcCheckpoint|gcRestore|gcSlabCount|gcSlabBytes|bufNew|bufStr|bufGetByte|bufGetWord|bufGetDword|bufGetQword|bufGetDwordAt|bufGetQwordAt|bufSetByte|bufSetDword|bufSetDwordAt|handleOut|handleGet|handleInt|handleValid|toHandle|ptrDeref|ptrIndex|ptrAdd|ptrToInt|callPtr|rawAlloc|rawFree|rawRealloc|rawReadByte|rawReadWord|rawReadQword|rawWriteWord|rawWriteQword|sizeOf|environ|bitOr|bitAnd|bitXor|bitNot|shl|shr|div64|str|type|assert)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(func|fn|callback)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.krypton" },
            "2": { "name": "entity.name.function.krypton" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.krypton" }
          }
        }
      ]
    },
    "entry-point": {
      "patterns": [
        {
          "match": "\\b(just|go)\\s+(run|[a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
          "captures": {
            "1": { "name": "keyword.other.entry.krypton" },
            "2": { "name": "entity.name.section.krypton" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.krypton",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.krypton",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.krypton",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.krypton",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.krypton",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.krypton",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.krypton",
          "match": "->"
        },
        {
          "name": "keyword.operator.access.krypton",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.krypton",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.krypton",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.bracket.krypton",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.krypton",
          "match": "[,;:]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.krypton",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
